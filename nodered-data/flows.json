    {
        "id": "ab5a1f844dcd5deb",
        "type": "function",
        "z": "bf299fd77a21b151",
        "name": "Модель смешивания",
        "func": "if (!flow.get('systemRunning')) return null;\n\nlet temp = flow.get('temp') || 50;\nlet pid = flow.get('pid') || false;\nlet stabilized = flow.get('stabilized') || false;\n\n// Если уже стабилизировались - ничего не делаем\nif (stabilized) {\n    return null;\n}\n\nif (!pid && temp < 80) {\n    // Нагрев\n    temp = temp + 2;\n    if (temp >= 60) {\n        pid = true;\n        node.warn('🚨 АЛЕРТ! Температура: ' + temp + '°C');\n        node.warn('🔥 Активация ПИД-регулятора');\n    }\n} else if (pid && temp > 40) {\n    // Охлаждение\n    temp = temp - 1;\n    if (temp <= 40.5) {\n        pid = false;\n        stabilized = true;\n        node.warn('✅ Стабилизация на 40°C');\n        node.warn('✅ Процесс завершён');\n    }\n}\n\n// Сохраняем значения\nflow.set('temp', temp);\nflow.set('pid', pid);\nflow.set('stabilized', stabilized);\n\n// Отправляем в InfluxDB\nlet influxMsg = {\n    payload: {\n        measurement: \"water_mixer\",\n        fields: {\n            temperature: temp,\n            pid_active: pid ? 1 : 0\n        },\n        tags: {\n            device: \"digital_twin\"\n        }\n    }\n};\n\n// Отправляем оба сообщения: первое в InfluxDB, второе на дашборд\nnode.send([influxMsg, { payload: temp }]);\n\n\nreturn { payload: temp };",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 840,
        "y": 400,
        "wires": [
