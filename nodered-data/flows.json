    {
        "id": "dc041e5286ef0606",
        "type": "function",
        "z": "bf299fd77a21b151",
        "name": "Логика",
        "func": "// Сбрасываем все флаги при старте\nflow.set('systemRunning', true);\nflow.set('temp', 50);           // Начальная температура\nflow.set('pid', false);         // ПИД выключен\nflow.set('stabilized', false);  // СБРАСЫВАЕМ ФЛАГ СТАБИЛИЗАЦИИ\n\nnode.warn('🚀 СИСТЕМА ЗАПУЩЕНА');\nnode.warn('🌡️ Начальная температура: 50°C');\nnode.warn('⏳ Начинаем нагрев...');\n\nmsg.payload = { status: 'running', temp: 50 };\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 660,
        "y": 540,
        "wires": [
            [
                "5b81c5e124352087",
                "2834f868063b3ef2"
            ]
        ]
    },
